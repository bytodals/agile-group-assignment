# EXAMPLE FILE - copy to .env and fill in your values

NODE_ENV=development
PORT=3000

# Frontend origin allowed by CORS (default: http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# Atlas connection string (required when USE_LOCAL_DB=false)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# --- Local MongoDB (no Atlas access / mobile network) ---
# Set USE_LOCAL_DB=true to connect to your local MongoDB instead of Atlas.
# MONGODB_LOCAL_URI defaults to mongodb://localhost:27017/ennabook if not set.
USE_LOCAL_DB=true

MONGODB_LOCAL_URI=mongodb://localhost:27017/ennabook

# Windows setup (one-time):
#   1. Download MongoDB Community Server (MSI) from mongodb.com/try/download/community
#   2. Install with "Install MongoD as a Service" checked (auto-starts on boot)
#   3. Set USE_LOCAL_DB=true in your .env
#   4. npm install
#   5. npm run seed:local   ← imports data from data/seed-data.json
#   6. npm run dev:local    ← starts server on localhost:3000
