#!/bin/sh

CSS_VIOLATIONS=$(git ls-files '*.css' | grep -v '^AnnaBook/src/styles/' || true)
if [ -n "$CSS_VIOLATIONS" ]; then
  echo ""
  echo "ERROR: CSS files must only be placed in AnnaBook/src/styles/"
  echo "Move these files there or remove them from staging:"
  echo "$CSS_VIOLATIONS" | sed 's/^/  /'
  echo ""
  exit 1
fi

if [ -d "AnnaBook/node_modules" ]; then
  npx --no -- lint-staged --cwd AnnaBook || { echo "ERROR: lint-staged failed in AnnaBook — run: cd AnnaBook && npx lint-staged"; exit 1; }
fi

if [ -d "server/node_modules" ]; then
  npx --no -- lint-staged --cwd server || { echo "ERROR: lint-staged failed in server — run: cd server && npx lint-staged"; exit 1; }
fi
